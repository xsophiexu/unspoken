{
  "name": "unspoken-workspace",
  "private": true,
  "description": "Unspoken: a Taboo-style word game for iOS, Android and web.",
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "mobile": "pnpm --filter @unspoken/mobile start",
    "mobile:web": "pnpm --filter @unspoken/mobile web",
    "build:mobile-web": "pnpm --filter @unspoken/mobile build:web",
    "web": "pnpm --filter @unspoken/web dev",
    "build:web": "pnpm --filter @unspoken/web build"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
