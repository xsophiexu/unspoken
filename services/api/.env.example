# Copy to .env.local for `pnpm dev` and `pnpm start` (gitignored). On Railway, set these as service
# variables (see README.md). Blank or missing means the default.

# Port to listen on. Railway sets it.
PORT=8080

# Comma-separated browser origins allowed to call the API (scheme, host and port, no path). Native
# apps send no Origin and need no entry.
CORS_ORIGINS=https://xsophiexu.github.io,http://localhost:8081,http://localhost:3000

# Proxies in front of the service that append the caller's address to X-Forwarded-For, used for the
# per-caller rate limit. 0 when clients connect directly (local), 2 on Railway (the Docker image's
# default), since its edge sends the client followed by one hop of its own.
TRUST_PROXY_HOPS=0

# Largest request body accepted, in bytes.
BODY_LIMIT_BYTES=8192

# Feedback each caller may send per window.
FEEDBACK_RATE_LIMIT=5
FEEDBACK_RATE_WINDOW_SECONDS=600

# Postgres that stores feedback. On Railway, reference the database's: ${{Postgres.DATABASE_URL}}.
# Leave blank to turn feedback off (POST /v1/feedback answers 503 unavailable; everything else works).
# Locally, for example: postgresql://postgres:postgres@localhost:5432/unspoken
DATABASE_URL=
