# Copy to .env.local for `pnpm dev` and `pnpm start` (gitignored). In production set these on the
# host (Cloud Run: --set-env-vars, secrets with --set-secrets). Blank or missing means the default.

# Port to listen on. Cloud Run sets it.
PORT=8080

# Comma-separated browser origins allowed to call the API (scheme, host and port, no path). Native
# apps send no Origin and need no entry.
CORS_ORIGINS=https://xsophiexu.github.io,http://localhost:8081,http://localhost:3000

# Proxies in front of the service that append the caller's address to X-Forwarded-For, used for the
# per-caller rate limit. 0 when clients connect directly (local), 1 on Cloud Run (the Docker image's
# default), 2 behind an external Application Load Balancer.
TRUST_PROXY_HOPS=0

# Largest request body accepted, in bytes.
BODY_LIMIT_BYTES=8192

# Feedback each caller may send per window.
FEEDBACK_RATE_LIMIT=5
FEEDBACK_RATE_WINDOW_SECONDS=600

# Firestore collection that stores feedback.
FEEDBACK_COLLECTION=feedback

# Firebase project that stores feedback. Leave blank to turn feedback off (POST /v1/feedback answers
# 503 unavailable; everything else works).
FIREBASE_PROJECT_ID=

# Credentials, in order of preference:
# - On Cloud Run, nothing: the service's runtime service account is used.
# - Locally, `gcloud auth application-default login`, or GOOGLE_APPLICATION_CREDENTIALS set to the
#   path of a service account key file.
# - Anywhere else, the key file's JSON on one line here. Its project is used when
#   FIREBASE_PROJECT_ID is blank.
FIREBASE_SERVICE_ACCOUNT=

# Use the local Firestore emulator instead of a real project, with no credentials (see README.md):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
