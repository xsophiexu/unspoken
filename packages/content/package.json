{
  "name": "@unspoken/content",
  "version": "0.1.0",
  "private": true,
  "description": "Unspoken content: the word bank and the copy catalog. Loaded by the service and by offline clients.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
