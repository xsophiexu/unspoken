    "./copy": "./src/copy/index.ts",
    "./word-banks.json": "./data/word-banks.json"
  },
  "dependencies": {
    "@unspoken/core": "workspace:*"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  }
}
