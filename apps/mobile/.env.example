# Copy to .env.local (gitignored) and fill in. Public values ship inside the app, so never put secrets here.
# Base URL of services/api, which receives Send feedback. Without it, sending shows an error and keeps the text.
EXPO_PUBLIC_API_URL=
# Google Analytics 4 measurement id for the web build (G-XXXXXXXXXX). Leave empty to load no analytics.
EXPO_PUBLIC_GA_MEASUREMENT_ID=
