# Copy to .env.local (gitignored) to override .env. Public values ship inside the app, so never put secrets here.
# Firebase web config (Firebase console > Project settings > Your apps). Send feedback signs in
# anonymously and writes to Firestore. Without all six, sending shows an error and keeps the text.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Google Analytics 4 measurement id for the web build (G-XXXXXXXXXX). Leave empty to load no analytics.
EXPO_PUBLIC_GA_MEASUREMENT_ID=
