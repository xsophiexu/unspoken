# Copy to .env.local for local development. Every value is public: it ships in the static site.

# Serve the site from a sub-path (GitHub Pages uses /unspoken). Leave empty to serve from /.
NEXT_PUBLIC_BASE_PATH=

# Base URL of services/api. Send feedback posts to {NEXT_PUBLIC_API_URL}/v1/feedback.
# When it is empty the feedback screen shows an inline error and keeps the text.
NEXT_PUBLIC_API_URL=

# Google Analytics measurement id (G-XXXXXXX). Leave empty to load no analytics.
NEXT_PUBLIC_GA_ID=
