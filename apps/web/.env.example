# Copy to .env.local for local development. Every value is public: it ships in the static site.

# Serve the site from a sub-path (GitHub Pages used /unspoken). Leave empty to serve from /.
NEXT_PUBLIC_BASE_PATH=

# Firebase web config (Firebase console > Project settings > Your apps). Send feedback signs in
# anonymously and writes to the Firestore feedback collection; firestore.rules guards it.
# Until all six are set the feedback screen shows an inline error and keeps the text.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Analytics measurement id (G-XXXXXXX). Leave empty to load no analytics.
NEXT_PUBLIC_GA_ID=
